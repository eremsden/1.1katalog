<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 380" width="540" height="380">
    <rect width="540" height="380" fill="#ffffff" rx="12" stroke="#cbd5e1" stroke-width="2"/>
    
  <defs>
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e1ecf4" stroke-width="1"/>
    </pattern>
    <linearGradient id="metalCylinder" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#243447" />
      <stop offset="35%" stop-color="#415975" />
      <stop offset="70%" stop-color="#243447" />
      <stop offset="100%" stop-color="#15212d" />
    </linearGradient>
    <linearGradient id="chromeRod" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#cfd8dc" />
      <stop offset="25%" stop-color="#ffffff" />
      <stop offset="50%" stop-color="#b0bec5" />
      <stop offset="75%" stop-color="#90a4ae" />
      <stop offset="100%" stop-color="#607d8b" />
    </linearGradient>
    <linearGradient id="brassThread" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d4af37" />
      <stop offset="50%" stop-color="#fff2a8" />
      <stop offset="100%" stop-color="#aa8c2c" />
    </linearGradient>
    <linearGradient id="steelPart" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#78909c" />
      <stop offset="40%" stop-color="#cfd8dc" />
      <stop offset="80%" stop-color="#546e7a" />
      <stop offset="100%" stop-color="#37474f" />
    </linearGradient>
  </defs>

    <rect width="540" height="380" fill="url(#grid)" rx="12"/>
    <rect x="20" y="20" width="500" height="50" rx="8" fill="#f1f5f9" stroke="#e2e8f0" stroke-width="1"/>
    <text x="35" y="44" font-family="'Manrope', sans-serif" font-size="16" font-weight="800" fill="#1b2a3a">Шарнирный наконечник A246 / B246 (Пластик)</text>
    <text x="35" y="60" font-family="'Manrope', sans-serif" font-size="11" font-weight="600" fill="#475569">Шаровой палец Ø10 мм · Резьба M8 · Длина оси +19 мм</text>
    
    <g transform="translate(150, 100)">
      <rect x="25" y="42" width="40" height="16" rx="2" fill="#334155"/>
    <rect x="65" y="32" width="45" height="36" rx="18" fill="#1e293b" stroke="#0f172a" stroke-width="1.5"/>
    <circle cx="88" cy="50" r="10" fill="#29abe2"/>
    <rect x="110" y="45" width="25" height="10" rx="2" fill="#475569"/>
    </g>

    <rect x="30" y="320" width="480" height="40" rx="6" fill="#e7f6fc" stroke="#29abe2" stroke-width="1"/>
    <text x="270" y="345" font-family="'Manrope', sans-serif" font-size="12" font-weight="700" fill="#0369a1" text-anchor="middle">SUSPA GmbH &amp; Dikon · Промышленный стандарт качества</text>
  </svg>