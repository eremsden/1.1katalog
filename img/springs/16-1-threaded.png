<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 220" width="720" height="220">
    <rect width="720" height="220" fill="#ffffff"/>
    
  <defs>
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e1ecf4" stroke-width="1"/>
    </pattern>
    <linearGradient id="metalCylinder" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#243447" />
      <stop offset="35%" stop-color="#415975" />
      <stop offset="70%" stop-color="#243447" />
      <stop offset="100%" stop-color="#15212d" />
    </linearGradient>
    <linearGradient id="chromeRod" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#cfd8dc" />
      <stop offset="25%" stop-color="#ffffff" />
      <stop offset="50%" stop-color="#b0bec5" />
      <stop offset="75%" stop-color="#90a4ae" />
      <stop offset="100%" stop-color="#607d8b" />
    </linearGradient>
    <linearGradient id="brassThread" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d4af37" />
      <stop offset="50%" stop-color="#fff2a8" />
      <stop offset="100%" stop-color="#aa8c2c" />
    </linearGradient>
    <linearGradient id="steelPart" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#78909c" />
      <stop offset="40%" stop-color="#cfd8dc" />
      <stop offset="80%" stop-color="#546e7a" />
      <stop offset="100%" stop-color="#37474f" />
    </linearGradient>
  </defs>

    <rect width="720" height="220" fill="url(#grid)"/>
    
    <!-- Title & Specs -->
    <text x="30" y="32" font-family="'Manrope', sans-serif" font-size="16" font-weight="800" fill="#1b2a3a">SUSPA Серия 16-1 (Резьбовое соединение)</text>
    <text x="30" y="52" font-family="'Manrope', sans-serif" font-size="11" font-weight="600" fill="#5b6b7c">Чертеж и основные размеры · Техническая спецификация Dikon</text>

    <!-- Center line -->
    <line x1="20" y1="110" x2="700" y2="110" stroke="#29abe2" stroke-width="1" stroke-dasharray="6,4"/>

    <!-- Tube (Cylinder) -->
    <rect x="60" y="90" width="340" height="40" rx="3" fill="url(#metalCylinder)" stroke="#15212d" stroke-width="1.5"/>
    <text x="230" y="115" font-family="'Manrope', sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle">ТРУБКА (ЦИЛИНДР)</text>

    <!-- Rod (Piston Rod) -->
    <rect x="400" y="98" width="260" height="24" rx="2" fill="url(#chromeRod)" stroke="#607d8b" stroke-width="1"/>
    <text x="530" y="114" font-family="'Manrope', sans-serif" font-size="11" font-weight="700" fill="#243447" text-anchor="middle">ШТОК</text>

    <!-- Ends -->
    <rect x="35" y="103" width="25" height="14" fill="url(#brassThread)" rx="1"/><line x1="35" y1="106" x2="60" y2="106" stroke="#aa8c2c" stroke-width="1"/><line x1="35" y1="110" x2="60" y2="110" stroke="#aa8c2c" stroke-width="1"/><line x1="35" y1="114" x2="60" y2="114" stroke="#aa8c2c" stroke-width="1"/>
    <rect x="660" y="105" width="25" height="10" fill="url(#brassThread)" rx="1"/><line x1="660" y1="108" x2="685" y2="108" stroke="#aa8c2c" stroke-width="1"/><line x1="660" y1="112" x2="685" y2="112" stroke="#aa8c2c" stroke-width="1"/>

    <!-- Dimension lines -->
    <!-- Tube length T -->
    <line x1="60" y1="150" x2="400" y2="150" stroke="#243447" stroke-width="1.5"/>
    <path d="M 60 146 L 60 154 M 400 146 L 400 154" stroke="#243447" stroke-width="1.5"/>
    <path d="M 68 150 L 60 150 M 392 150 L 400 150" stroke="#243447" stroke-width="1.5"/>
    <text x="230" y="166" font-family="'Manrope', sans-serif" font-size="11" font-weight="800" fill="#1b2a3a" text-anchor="middle">T (длина трубки)</text>

    <!-- Stroke S -->
    <line x1="400" y1="150" x2="660" y2="150" stroke="#29abe2" stroke-width="1.5"/>
    <path d="M 400 146 L 400 154 M 660 146 L 660 154" stroke="#29abe2" stroke-width="1.5"/>
    <text x="530" y="166" font-family="'Manrope', sans-serif" font-size="11" font-weight="800" fill="#29abe2" text-anchor="middle">S (ход штока)</text>

    <!-- Total L1 -->
    <line x1="35" y1="190" x2="685" y2="190" stroke="#1b2a3a" stroke-width="2"/>
    <path d="M 35 184 L 35 196 M 685 184 L 685 196" stroke="#1b2a3a" stroke-width="2"/>
    <text x="360" y="206" font-family="'Manrope', sans-serif" font-size="12" font-weight="800" fill="#1b2a3a" text-anchor="middle">L / L1 (общая длина)</text>
  </svg>