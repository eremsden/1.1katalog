<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 240" width="400" height="240">
    <rect width="400" height="240" fill="#f4f8fb"/>
    
  <defs>
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e1ecf4" stroke-width="1"/>
    </pattern>
    <linearGradient id="metalCylinder" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#243447" />
      <stop offset="35%" stop-color="#415975" />
      <stop offset="70%" stop-color="#243447" />
      <stop offset="100%" stop-color="#15212d" />
    </linearGradient>
    <linearGradient id="chromeRod" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#cfd8dc" />
      <stop offset="25%" stop-color="#ffffff" />
      <stop offset="50%" stop-color="#b0bec5" />
      <stop offset="75%" stop-color="#90a4ae" />
      <stop offset="100%" stop-color="#607d8b" />
    </linearGradient>
    <linearGradient id="brassThread" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d4af37" />
      <stop offset="50%" stop-color="#fff2a8" />
      <stop offset="100%" stop-color="#aa8c2c" />
    </linearGradient>
    <linearGradient id="steelPart" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#78909c" />
      <stop offset="40%" stop-color="#cfd8dc" />
      <stop offset="80%" stop-color="#546e7a" />
      <stop offset="100%" stop-color="#37474f" />
    </linearGradient>
  </defs>

    <rect width="400" height="240" fill="url(#grid)" />
    <rect x="20" y="20" width="360" height="200" rx="12" fill="#ffffff" stroke="#d7e2ea" stroke-width="2"/>
    <circle cx="200" cy="95" r="50" fill="#e7f6fc" stroke="#29abe2" stroke-width="2" />
    <g transform="translate(160, 75) scale(0.8)">
    <rect x="0" y="15" width="50" height="18" rx="3" fill="url(#metalCylinder)"/>
    <rect x="50" y="19" width="40" height="10" rx="1" fill="url(#chromeRod)"/>
    <rect x="90" y="17" width="10" height="14" rx="2" fill="#29abe2"/>
    <circle cx="95" cy="24" r="3" fill="#ffffff"/>
    <circle cx="-5" cy="24" r="6" fill="#78909c"/>
  </g>
    <text x="200" y="175" font-family="'Manrope', sans-serif" font-size="16" font-weight="800" fill="#1b2a3a" text-anchor="middle">Блокируемые пружины</text>
    <text x="200" y="198" font-family="'Manrope', sans-serif" font-size="12" font-weight="600" fill="#5b6b7c" text-anchor="middle">Varilock & VOB · Фиксация штока</text>
  </svg>